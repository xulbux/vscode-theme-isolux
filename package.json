{
  "name": "theme-isolux",
  "version": "1.0.3",
  "displayName": "Isolux Theme",
  "description": "Calm dark and light themes with clear, semantic syntax colors.",
  "categories": ["Themes"],
  "keywords": [
    "accessible",
    "black",
    "calm",
    "color",
    "dark",
    "isolux",
    "light",
    "minimal",
    "modern",
    "neutral",
    "oklch",
    "premium",
    "professional",
    "purple",
    "semantic",
    "syntax",
    "theme",
    "violet"
  ],
  "author": { "name": "XulbuX", "email": "hi@xul.is" },
  "maintainers": ["XulbuX <hi@xul.is>"],
  "publisher": "xulbux",
  "bugs": { "url": "https://github.com/xulbux/vscode-theme-isolux/issues" },
  "repository": { "type": "git", "url": "https://github.com/xulbux/vscode-theme-isolux" },
  "license": "MIT",
  "type": "module",
  "contributes": {
    "themes": [
      { "label": "Isolux Pro Dark", "uiTheme": "vs-dark", "path": "./dist/isolux-pro-dark.json" },
      { "label": "Isolux Pro Light", "uiTheme": "vs", "path": "./dist/isolux-pro-light.json" }
    ]
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:strict": "node scripts/build.ts --strict",
    "check": "pnpm run fmt:check && pnpm run lint:check && pnpm run type-check && pnpm run test && pnpm run build:strict",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "test": "node --test \"test/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "vscode:prepublish": "node scripts/build.ts --strict",
    "watch": "node --watch-path=theme --watch-path=scripts --watch-path=package.json scripts/build.ts"
  },
  "icon": "./assets/icon.png",
  "galleryBanner": { "color": "#101010", "theme": "dark" },
  "engines": { "node": ">=26", "vscode": "^1.87.0" },
  "sponsor": { "url": "https://github.com/sponsors/xulbux" },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
