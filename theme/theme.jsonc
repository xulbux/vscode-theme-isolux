  "tokenColors": [
    {
      "scope": [
        "comment",
        "constant.numeric.line-number.find-in-files",
        "constant.numeric.line-number.match.find-in-files",
        "invalid", // Muted on purpose; VS Code also flags parts of signature help as invalid.
        "log.date",
        "log.time",
        "meta.at-rule.keyframes.body",
        "punctuation.definition.comment",
        "string.quoted.docstring punctuation.definition.string",
        "string.quoted.docstring",
        "token.error-token"
      ],
      "settings": { "foreground": "token.comment" }
    },
    {
      "scope": [
        "fenced_code.block.language",
        "keyword.operator.access.dot.rust",
        "keyword.operator.arrow.skinny.rust",
        "keyword.operator.assignment.dotenv",
        "keyword.operator.assignment.jsx",
        "keyword.operator.heading.restructuredtext",
        "keyword.operator.key-value.rust",
        "keyword.operator.namespace.rust",
        "keyword.operator.table.row.restructuredtext keyword.operator.table.data.restructuredtext",
        "keyword.operator.type.annotation",
        "keyword.other.parenthesis.elm",
        "keyword.other.substitution",
        "log.verbose",
        "markup.hr.markdown",
        "markup.ignored punctuation.definition.ignored",
        "markup.ignored",
        "markup.untracked",
        "meta.at-rule.each",
        "meta.attribute.directive punctuation.definition.string",
        "meta.attribute.event-handler punctuation.definition.string",
        "meta.attribute.style punctuation.definition.string",
        "meta.brace",
        "meta.brackets entity.name.function.operator",
        "meta.delimiter",
        "meta.function-call.method.without-arguments.js",
        "meta.function-call.without-arguments.js",
        "meta.link.email.lt-gt",
        "meta.link.reference punctuation.definition.constant",
        "meta.separator.markdown",
        "meta.tag.preprocessor.xml", // Only `=` is unscoped in XML tags.
        "meta.tag.xml",
        "meta.type storage.modifier.array",
        "punctuation.definition.group.begin.css",
        "punctuation.definition.group.begin.ruby",
        "punctuation.definition.group.end.css",
        "punctuation.definition.group.end.ruby",
        "punctuation.definition.string.end.html source.css",
        "punctuation.definition.tag source",
        "punctuation.separator entity.name.function.operator",
        "punctuation.separator.parameter",
        "punctuation",
        "source.diff", // Unchanged context lines recede behind the changes.
        "source.git-diff.command meta.diff.git-diff.header.from-file",
        "source.git-diff.command meta.diff.git-diff.header.to-file",
        "source.git-show meta.diff.header.from-file",
        "source.git-show meta.diff.header.to-file",
        "string punctuation.definition.string source",
        "string source punctuation.section.embedded",
        "support.function.delimiter.elm"
      ],
      "settings": { "foreground": "token.punctuation" }
    },
    {
      "scope": [
        "comment entity.name.tag",
        "comment entity.name.type",
        "comment keyword",
        "constant.other.ellipsis",
        "entity.name.decorator",
        "entity.name.function.decorator",
        "keyword.other.phpdoc",
        "meta.decorator entity.name.function",
        "meta.decorator variable.other.object",
        "meta.decorator variable.other.readwrite",
        "meta.function.decorator",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "punctuation.definition.decorator",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "token.annotation" }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.tag.documentation",
        "entity.name.type.namespace",
        "entity.name.type.package.go",
        "markup.fenced_code.block",
        "markup.raw.block.markdown",
        "meta.annotation.rust keyword.operator",
        "meta.annotation.rust keyword",
        "meta.annotation.rust string",
        "meta.annotation.rust",
        "meta.attribute.rust string",
        "meta.attribute.rust",
        "meta.use.php entity.name.type",
        "punctuation.definition.entity",
        "punctuation.definition.variable",
        "storage.modifier.import",
        "storage.modifier.package",
        "string.other.git-status.help.key",
        "support.other.namespace",
        "support.type.object.module",
        "support.type.vendor-prefix.css",
        "support.variable",
        "variable.annotation.rust",
        "variable.language",
        "variable.other.global.php",
        "variable.parameter.function.language.special.cls.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.positional"
      ],
      "settings": { "foreground": "token.namespace" }
    },
    {
      "scope": [
        "comment.other.git-status.head",
        "entity.name.operator.custom-literal",
        "meta.jsx.children",
        "meta.object.member",
        "meta.paragraph.markdown",
        "meta.template-tag",
        "meta.type_params.rust",
