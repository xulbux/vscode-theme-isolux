{
  "$schema": "../dist/xulbux-pro.schema.json",
  "type": "dark",
  "name": "XulbuX PRO",
  "author": "XulbuX",
  "maintainers": ["XulbuX <hi@xul.is>"],
  "semanticClass": "theme.xulbux-pro",
  "semanticHighlighting": true,
  "palette": {
    "gray": {
      "50": "#FAFAFA",
      "100": "#E3E3E3",
      "200": "#BDBDBD",
      "300": "#8A8A8A",
      "400": "#636363",
      "500": "#505050",
      "600": "#3D3D3D",
      "700": "#2C2C2C",
      "800": "#222222",
      "900": "#161616",
      "950": "#000000"
    },
    "indigo": "#959DFF",
    "violet": "#AA94FF",
    "purple": "#C187FF",
    "orchid": "#D67AFD",
    "fuchsia": "#E66FF3",
    "pink": "#F56FCA",
    "rose": "#FF6EA5",
    "red": "#FF7680",
    "coral": "#FA7D6C",
    "orange": "#EF8862",
    "amber": "#EC8C49",
    "green": "#60C077",
    "teal": "#10C3A0",
    "cyan": "#46BDB6",
    "ansi": {
      "foreground": "indigo-200",
      "black": "gray-700",
      "red": "red-400",
      "green": "green-200",
      "yellow": "amber-300",
      "blue": "indigo-500",
      "magenta": "violet-400",
