      "bright-magenta": "purple-300",
      "bright-cyan": "cyan-100",
      "bright-white": "gray-50"
    },
    "ui": {
      "surface": { "hover": "gray-800", "active": "gray-700" },
      "accent": {
        "base": "violet-400",
        "hover": "violet-500",
        "bg": "violet-500",
        "bg-hover": "ui-accent-bg%96"
      },
      "error": { "base": "red-400", "hover": "ui-error-base%96", "bg": "red-950" },
      "warning": { "base": "amber-300", "hover": "ui-warning-base%96", "bg": "amber-950" },
      "info": { "base": "indigo-400", "bg": "indigo-950" },
      "success": { "base": "indigo-400" },
      "added": { "base": "indigo-400" },
      "modified": { "base": "purple-400" },
      "removed": { "base": "red-400" },
      "match": { "base": "teal-200" },
      "conflict": { "base": "fuchsia-400" },
      "offline": { "base": "coral-400", "hover": "ui-offline-base%96" },
      "ai": { "base": "purple-400" }
    }
  },
